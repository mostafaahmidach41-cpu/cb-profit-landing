---
const affiliateLink = "https://dcff77kuqvzpxoeajgucl-wohw.hop.clickbank.net";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClickBank Profit Club</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body {
        background: radial-gradient(circle at top right, #1e293b 0%, #000000 100%);
      }
      .neon-glow {
        text-shadow: 0 0 20px rgba(59, 130, 246, 0.8);
      }
    </style>
  </head>
  <body class="text-white antialiased font-sans bg-black">
    <main class="max-w-[480px] mx-auto min-h-screen flex flex-col items-center px-6 py-12 text-center">
      
      <div class="mb-10 w-24 h-24 bg-blue-600 rounded-3xl flex items-center justify-center shadow-[0_0_50px_rgba(37,99,235,0.3)] animate-pulse">
        <span class="text-5xl font-black text-white">$</span>
      </div>

      <h1 class="text-4xl font-black mb-6 leading-tight uppercase">
        Join the Elite <br/>
        <span class="text-blue-500 text-6xl italic neon-glow">$260.16</span> <br/>
        System
      </h1>

      <div class="w-full grid grid-cols-2 gap-4 mb-10">
        <div class="bg-white/5 p-6 rounded-2xl border border-white/10">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1">Avg $/Sale</p>
          <p class="text-3xl font-bold text-blue-400">$260.16</p>
        </div>
        <div class="bg-white/5 p-6 rounded-2xl border border-white/10">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1">Conv Rate</p>
          <p class="text-3xl font-bold text-cyan-400">3.22%</p>
        </div>
      </div>

      <a href={affiliateLink} class="w-full py-6 bg-blue-600 hover:bg-blue-500 transition-all rounded-2xl text-2xl font-black shadow-lg">
        GET STARTED NOW 🚀
      </a>
      
    </main>
  </body>
</html>
