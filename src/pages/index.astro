---
// English language only as requested
const affiliateLink = "https://dcff77kuqvzpxoeajgucl-wohw.hop.clickbank.net";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClickBank Profit Club | Exclusive VIP Access</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body {
        background: radial-gradient(circle at top, #0f172a 0%, #000000 100%);
      }
    </style>
  </head>
  <body class="text-white font-sans antialiased">
    <main class="max-w-[480px] mx-auto min-h-screen flex flex-col items-center px-6 py-12 text-center">
      
      <div class="mb-8 w-20 h-20 bg-blue-600 rounded-2xl flex items-center justify-center shadow-2xl shadow-blue-500/40 rotate-3 animate-bounce">
        <span class="text-4xl font-black">$</span>
      </div>

      <h1 class="text-3xl font-black mb-6 leading-tight uppercase tracking-tighter">
        Join the Elite <br/>
        <span class="text-blue-500 text-5xl italic">$260.16</span> <br/>
        Profit System
      </h1>

      <p class="text-slate-400 text-lg mb-10 font-medium">
        Access the 9x Platinum Vendor's Private Club. <br/> 
        Real Traffic. Real Conversions. 📈
      </p>

      <div class="w-full grid grid-cols-2 gap-4 mb-10">
        <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1">Avg $/Sale</p>
          <p class="text-2xl font-bold text-blue-400">$260.16</p>
        </div>
        <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1">Conv Rate</p>
          <p class="text-2xl font-bold text-blue-400">3.22%</p>
        </div>
      </div>

      <div class="w-full space-y-4 mb-12 text-left bg-white/5 p-6 rounded-3xl border border-white/10">
        <div class="flex items-center gap-4">
          <div class="bg-blue-500 rounded-full p-1 text-[10px]">✔</div>
          <span class="text-slate-200">Exclusive VIP Traffic Sources</span>
        </div>
        <div class="flex items-center gap-4">
          <div class="bg-blue-500 rounded-full p-1 text-[10px]">✔</div>
          <span class="text-slate-200">9x Platinum Proven Blueprints</span>
        </div>
        <div class="flex items-center gap-4">
          <div class="bg-blue-500 rounded-full p-1 text-[10px]">✔</div>
          <span class="text-slate-200">Instant Worldwide Access</span>
        </div>
      </div>

      <a href={affiliateLink} class="w-full py-6 bg-blue-600 hover:bg-blue-700 rounded-2xl text-xl font-black transition-all transform hover:scale-[1.05] shadow-xl shadow-blue-900/40">
        GET STARTED NOW 🚀
      </a>

      <footer class="mt-16 text-[10px] text-slate-600 uppercase tracking-[0.2em] font-bold">
        Verified ClickBank® Partner Offer
      </footer>
      
    </main>
  </body>
</html>
