---
// English language only for a professional international look
const affiliateLink = "https://dcff77kuqvzpxoeajgucl-wohw.hop.clickbank.net";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClickBank Profit Club | Exclusive VIP Access</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body {
        background: radial-gradient(circle at top right, #1e293b 0%, #000000 100%);
      }
      .glass-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .neon-glow {
        text-shadow: 0 0 20px rgba(59, 130, 246, 0.6);
      }
      .btn-shine {
        background: linear-gradient(90deg, #2563eb, #06b6d4, #2563eb);
        background-size: 200% auto;
        animation: shine 3s linear infinite;
      }
      @keyframes shine {
        to { background-position: 200% center; }
      }
    </style>
  </head>
  <body class="text-white font-sans antialiased selection:bg-blue-500/30">
    <main class="max-w-[480px] mx-auto min-h-screen flex flex-col items-center px-6 py-12 text-center">
      
      <div class="mb-10 w-24 h-24 bg-gradient-to-tr from-blue-600 to-cyan-400 rounded-3xl flex items-center justify-center shadow-[0_0_50px_rgba(37,99,235,0.3)] rotate-3 animate-pulse">
        <span class="text-5xl font-black text-white">$</span>
      </div>

      <h1 class="text-4xl font-black mb-6 leading-tight uppercase tracking-tighter">
        Join the Elite <br/>
        <span class="text-blue-500 text-6xl italic neon-glow">$260.16</span> <br/>
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-400">Profit System</span>
      </h1>

      <p class="text-slate-400 text-lg mb-10 font-medium leading-relaxed">
        Access the 9x Platinum Vendor's Private Club. <br/> 
        <span class="text-cyan-400">Real Traffic • Real Conversions 📈</span>
      </p>

      <div class="w-full grid grid-cols-2 gap-4 mb-10">
        <div class="glass-card p-6 rounded-2xl">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1 tracking-widest">Avg $/Sale</p>
          <p class="text-3xl font-bold text-blue-400">$260.16</p>
        </div>
        <div class="glass-card p-6 rounded-2xl">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1 tracking-widest">Conv Rate</p>
          <p class="text-3xl font-bold text-cyan-400">3.22%</p>
        </div>
      </div>

      <div class="w-full space-y-4 mb-12 text-left glass-card p-8 rounded-[2.5rem]">
        <div class="flex items-center gap-4 group">
          <div class="bg-blue-500 shadow-[0_0_15px_rgba(59,130,246,0.5)] rounded-full p-1 text-[10px]">✔</div>
          <span class="text-slate-200 font-semibold group-hover:text-white transition-colors">Exclusive VIP Traffic Sources</span>
        </div>
        <div class="flex items-center gap-4 group">
          <div class="bg-blue-500 shadow-[0_0_15px_rgba(59,130,246,0.5)] rounded-full p-1 text-[10px]">✔</div>
          <span class="text-slate-200 font-semibold group-hover:text-white transition-colors">9x Platinum Proven Blueprints</span>
        </div>
        <div class="flex items-center gap-4 group">
          <div class="bg-blue-500 shadow-[0_0_15px_rgba(59,130,246,0.5)] rounded-full p-1 text-[10px]">✔</div>
          <span class="text-slate-200 font-semibold group-hover:text-white transition-colors">Instant Worldwide Access</span>
        </div>
      </div>

      <a href={affiliateLink} class="w-full py-6 btn-shine rounded-2xl text-2xl font-black transition-all transform hover:scale-[1.03] active:scale-95 shadow-[0_20px_50px_rgba(37,99,235,0.4)]">
        GET STARTED NOW 🚀
      </a>

      <footer class="mt-20 text-[10px] text-slate-600 uppercase tracking-[0.4em] font-bold">
        Verified ClickBank® Partner Offer
      </footer>
      
    </main>
  </body>
</html>
