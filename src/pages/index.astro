---
// 100% English - Professional Conversion Design
const affiliateLink = "https://dcff77kuqvzpxoeajgucl-wohw.hop.clickbank.net";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Elite Profit Blueprint | VIP Access</title>
    <style>
      body {
        background: radial-gradient(circle at top right, #1a202c 0%, #000000 100%) !important;
        color: white;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        text-align: center;
      }

      .container {
        max-width: 400px;
        width: 90%;
        padding: 40px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      }

      .icon-box {
        background: linear-gradient(135deg, #2563eb, #06b6d4);
        width: 80px;
        height: 80px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
        font-size: 45px;
        font-weight: 900;
        box-shadow: 0 0 35px rgba(37, 99, 235, 0.5);
      }

      h1 { 
        font-size: 34px; 
        font-weight: 900; 
        margin: 0; 
        text-transform: uppercase; 
        letter-spacing: -1px;
        line-height: 1.1; 
      }

      .highlight-price { 
        color: #3b82f6; 
        font-size: 60px; 
        font-style: italic; 
        display: block; 
        margin: 15px 0; 
        text-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
      }

      p { 
        color: #94a3b8; 
        font-size: 18px; 
        line-height: 1.5;
        margin-bottom: 40px; 
      }

      .cta-button {
        display: block;
        background: linear-gradient(to right, #2563eb, #06b6d4);
        color: white;
        text-decoration: none;
        padding: 22px;
        border-radius: 18px;
        font-size: 22px;
        font-weight: 900;
        transition: all 0.3s ease;
        box-shadow: 0 15px 30px rgba(37, 99, 235, 0.4);
        text-transform: uppercase;
      }

      .cta-button:hover { 
        transform: translateY(-3px) scale(1.02); 
        box-shadow: 0 20px 40px rgba(37, 99, 235, 0.6);
      }

      footer { 
        margin-top: 45px; 
        font-size: 10px; 
        color: #475569; 
        letter-spacing: 4px; 
        font-weight: bold;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="icon-box">$</div>
      <h1>Join the Elite<br><span class="highlight-price">$260.16</span>System</h1>
      <p>9x Platinum Vendor's Club Access.<br>Verified Real-Time Profit Strategy.</p>
      <a href={affiliateLink} class="cta-button">Get Started Now 🚀</a>
      <footer>Official ClickBank Partner</footer>
    </div>
  </body>
</html>
