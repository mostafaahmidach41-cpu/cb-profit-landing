---
// English language only for a professional look
const affiliateLink = "https://dcff77kuqvzpxoeajgucl-wohw.hop.clickbank.net";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClickBank Profit Club | Exclusive VIP Access</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
      body {
        background: radial-gradient(circle at top right, #1e293b 0%, #000000 100%);
      }
      .glass-effect {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .neon-text {
        text-shadow: 0 0 15px rgba(59, 130, 246, 0.8);
      }
      .cta-glow {
        box-shadow: 0 0 30px rgba(37, 99, 235, 0.5);
      }
    </style>
  </head>
  <body class="text-white font-sans antialiased">
    <main class="max-w-[480px] mx-auto min-h-screen flex flex-col items-center px-6 py-12 text-center">
      
      <div class="mb-10 w-24 h-24 bg-gradient-to-tr from-blue-600 to-cyan-400 rounded-3xl flex items-center justify-center shadow-2xl rotate-3 animate-pulse">
        <span class="text-5xl font-black">$</span>
      </div>

      <h1 class="text-4xl font-black mb-6 leading-tight uppercase tracking-tighter">
        Join the Elite <br/>
        <span class="text-blue-500 text-6xl italic neon-text tracking-normal">$260.16</span> <br/>
        Profit System
      </h1>

      <p class="text-slate-400 text-lg mb-10 font-medium leading-relaxed">
        Access the 9x Platinum Vendor's Private Club. <br/> 
        <span class="text-cyan-400 font-bold">Real Traffic • Real Conversions 📈</span>
      </p>

      <div class="w-full grid grid-cols-2 gap-4 mb-10">
        <div class="glass-effect p-6 rounded-2xl">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1">Avg $/Sale</p>
          <p class="text-3xl font-bold text-blue-400">$260.16</p>
        </div>
        <div class="glass-effect p-6 rounded-2xl">
          <p class="text-[10px] text-slate-500 uppercase font-black mb-1">Conv Rate</p>
          <p class="text-3xl font-bold text-cyan-400">3.22%</p>
        </div>
      </div>

      <div class="w-full space-y-4 mb-12 text-left glass-effect p-8 rounded-[2rem]">
        <div class="flex items-center gap-4">
          <div class="bg-blue-600 rounded-full p-1 shadow-lg shadow-blue-500/50">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <span class="text-slate-200 font-semibold tracking-wide">Exclusive VIP Traffic Sources</span>
        </div>
        <div class="flex items-center gap-4">
          <div class="bg-blue-600 rounded-full p-1 shadow-lg shadow-blue-500/50">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <span class="text-slate-200 font-semibold tracking-wide">9x Platinum Proven Blueprints</span>
        </div>
        <div class="flex items-center gap-4">
          <div class="bg-blue-600 rounded-full p-1 shadow-lg shadow-blue-500/50">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <span class="text-slate-200 font-semibold tracking-wide">Instant Worldwide Access</span>
        </div>
      </div>

      <a href={affiliateLink} class="w-full py-6 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 rounded-2xl text-2xl font-black transition-all transform hover:scale-[1.05] active:scale-95 cta-glow">
        GET STARTED NOW 🚀
      </a>

      <footer class="mt-16 text-[10px] text-slate-600 uppercase tracking-[0.3em] font-bold">
        Verified ClickBank® Partner Offer
      </footer>
      
    </main>
  </body>
</html>
